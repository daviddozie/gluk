OPENROUTER_API_KEY=your-api-key
OPENROUTER_MODEL=deepseek/deepseek-chat # Optional: defaults to deepseek/deepseek-chat
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash # Optional: multimodal model used to index chat images
VOYAGE_API_KEY=your-voyage-api-key

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-generated-secret

# Supabase Realtime workspace chat (project URL from Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://ocferceaklzhqjyurgbm.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only credentials. Import the public signing key into Supabase Auth JWT Signing Keys.
SUPABASE_SECRET_KEY=
SUPABASE_REALTIME_JWT_KID=
SUPABASE_REALTIME_JWT_PRIVATE_JWK=

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-token

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Vercel Blob (Recommended for direct document preview & storage)
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token

PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=your_index_name

TAVILY_API_KEY=your-tavily-api-key

# Optional: sends workspace invitation email. Without these, the owner gets a copyable invite link.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Gluk <invites@your-verified-domain.com>
